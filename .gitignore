# =========================
# Node.js / GitHub Action 项目 .gitignore
# =========================

# 依赖目录
node_modules/
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# 构建产物
build/
coverage/
.nyc_output/

# TypeScript / ncc / 编译缓存
*.tsbuildinfo
*.tgz
*.zip
*.log

# GitHub Actions 打包临时产物
*.js.map
.tmp/
__tests__/
test-results/
licenses.txt

# 环境变量 / 密钥配置
.env
.env.local
.env.*.local

# 编辑器配置
.vscode/
.idea/
*.swp

# macOS / Windows 系统垃圾文件
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 备份文件
*.bak
*.tmp
*.orig
